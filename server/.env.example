# Copy to server/.env and fill in what you have. Anything left empty stays OFF and
# the app says so plainly - nothing is ever simulated.

# --- Supabase: database + sign-in --------------------------------------------------
# Project URL and keys: Supabase dashboard -> Connect, and Settings -> API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses all database security - never put it in the web app.
SUPABASE_SECRET_KEY=
# Connect -> Session pooler URI, with your database password filled in.
# Empty = local embedded PostgreSQL in server/.data/pg (sign-in still needs Supabase).
DATABASE_URL=

# --- Twilio: automatic SOS texts (step 2) -----------------------------------------
# Twilio Console -> Account Info. (Login OTPs are configured in the Supabase dashboard.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number (+1...) or a Messaging Service SID (MG...).
TWILIO_FROM=

# --- Email (step 2) -----------------------------------------------------------------
# Any SMTP server, e.g. Gmail with an app password. Empty = email features off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hopin <you@example.com>

# --- App ------------------------------------------------------------------------------
PORT=8720
APP_URL=http://localhost:5190

# --- Razorpay: card / UPI / netbanking / wallet top-ups (step 4) ------------------
# Dashboard -> Account & Settings -> API Keys (Test Mode keys start with rzp_test_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks; the secret you type when adding the webhook.
RAZORPAY_WEBHOOK_SECRET=

# --- Trip recording (step 8b batch F) -----------------------------------------------
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes stored recordings unreadable. Without it, recording is off.
RECORDING_KEY=

# --- Push notifications (step 9) ---------------------------------------------------
# Generate once: npx web-push generate-vapid-keys. Changing them drops every saved subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Driver payouts (step 12) ------------------------------------------------------
# 32 random bytes, base64. Encrypts drivers' bank/UPI details. Without it, payouts are off.
PAYOUT_KEY=

# --- Live ETAs (step 11) ---------------------------------------------------------------
# Free key from openrouteservice.org (2,000 directions/day). Without it, live ETAs use OSRM.
ORS_API_KEY=

# --- Security (step 13) ---------------------------------------------------------------
# Set to 1 when running behind a hosting proxy so rate limits see real client IPs.
TRUST_PROXY=
